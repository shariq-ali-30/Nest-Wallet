# Server-only. Free key from https://etherscan.io/myapikey (needed for transaction history)
# Do not add the VITE_ prefix; this key must never be sent to the browser.
ETHERSCAN_API_KEY=

# Optional. Leave empty to use free public RPCs. Or paste Alchemy / Infura URLs.
VITE_SEPOLIA_RPC=
VITE_MAINNET_RPC=

# Optional RPC overrides for additional EVM networks
VITE_ARBITRUM_RPC=
VITE_BASE_RPC=
VITE_POLYGON_RPC=
